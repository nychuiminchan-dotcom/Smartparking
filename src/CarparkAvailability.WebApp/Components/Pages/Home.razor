@page "/"
@rendermode InteractiveServer
@inject ParkingApiClient ApiClient
@inject NominatimService Nominatim
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Smart Parking Navigator</PageTitle>

<div class="app-layout">
    <!-- Search & Filters panel -->
    <aside class="side-panel" aria-label="Search and filters">
        <div class="search-section">
            <form @onsubmit="OnSearchSubmit" @onsubmit:preventDefault>
                <label for="search-input" class="sr-only">Singapore destination</label>
                <div class="search-bar">
                    <input id="search-input"
                           type="search"
                           placeholder="Search a location in Singapore…"
                           value="@_searchQuery"
                           @oninput="OnSearchInput"
                           autocomplete="off"
                           aria-autocomplete="list"
                           aria-expanded="@(_suggestions.Count > 0)"
                           aria-controls="suggestions-list"
                           aria-label="Singapore destination search" />
                    <button type="submit" aria-label="Search" class="btn-search">
                        <span aria-hidden="true">🔍</span>
                    </button>
                </div>
            </form>

            @if (_suggestions.Count > 0)
            {
                <ul id="suggestions-list" class="suggestions" role="listbox" aria-label="Suggestions">
                    @foreach (var s in _suggestions)
                    {
                        <li role="option" @onclick="() => OnSuggestionSelected(s)" class="suggestion-item">
                            @s.DisplayName
                        </li>
                    }
                </ul>
            }
        </div>

        <details class="filters" open>
            <summary>Filters</summary>
            <div class="filter-group">
                <label>
                    <input type="checkbox" @bind="_filterShortTerm" @bind:after="OnFiltersChanged" />
                    Short-term parking
                </label>
                <label>
                    <input type="checkbox" @bind="_filterFreeParking" @bind:after="OnFiltersChanged" />
                    Free parking available
                </label>
                <label>
                    <input type="checkbox" @bind="_filterNightParking" @bind:after="OnFiltersChanged" />
                    Night parking
                </label>
            </div>
            <div class="filter-radius">
                <label for="radius-input">Search radius: <strong>@_radiusMetres m</strong></label>
                <input id="radius-input" type="range" min="100" max="2000" step="100"
                       @bind="_radiusMetres" @bind:after="OnFiltersChanged" />
            </div>
        </details>

        <!-- Results list -->
        <div class="results-section" aria-live="polite" aria-label="Car park results">
            @if (_loading)
            {
                <div class="state-loading" role="status">
                    <span class="spinner" aria-hidden="true"></span>
                    Searching for car parks…
                </div>
            }
            else if (_error != null)
            {
                <div class="state-error" role="alert">
                    <strong>Error:</strong> @_error
                </div>
            }
            else if (_searchLocation is null)
            {
                <div class="state-empty">
                    <p>Enter a Singapore destination to find nearby HDB car parks.</p>
                </div>
            }
            else if (_results is not null && _results.Count == 0)
            {
                <div class="state-empty">
                    <p>No car parks found within @_radiusMetres m of <em>@_searchLocation.DisplayName</em>.</p>
                    <p>Try increasing the search radius or changing filters.</p>
                </div>
            }
            else if (_results is not null)
            {
                @if (_dataStatus?.Status == AvailabilityStatus.Stale)
                {
                    <div class="status-banner stale" role="status">
                        ⚠ Availability data may be out of date.
                    </div>
                }
                else if (_dataStatus?.Status == AvailabilityStatus.Unavailable)
                {
                    <div class="status-banner unavailable" role="status">
                        ⚠ Live availability unavailable — showing static data only.
                    </div>
                }

                <p class="results-count">@_results.Count car park@(_results.Count == 1 ? "" : "s") found</p>

                <ul class="results-list" aria-label="Car park list">
                    @foreach (var cp in _results)
                    {
                        <li class="result-item @(_selected?.Id == cp.Id ? "selected" : "")"
                            @onclick="() => OnCarparkSelected(cp)"
                            role="button"
                            tabindex="0"
                            @onkeydown="(e) => OnResultKeyDown(e, cp)"
                            aria-selected="@(_selected?.Id == cp.Id)">
                            <div class="result-header">
                                <span class="result-id">@cp.Id</span>
                                <span class="result-distance">@FormatDistance(cp.DistanceMetres)</span>
                            </div>
                            <div class="result-address">@cp.Address</div>
                            <div class="result-availability">
                                @if (cp.AvailabilityStatus == AvailabilityStatus.Unavailable || cp.Lots.Count == 0)
                                {
                                    <span class="avail-unavail">Availability unknown</span>
                                }
                                else
                                {
                                    <span class="avail-lots @GetAvailClass(cp)">
                                        @cp.CarLots / @cp.TotalCarLots lots free
                                    </span>
                                    @if (cp.AvailabilityStatus == AvailabilityStatus.Stale)
                                    {
                                        <span class="avail-stale" title="Stale data">⚠</span>
                                    }
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </aside>

    <!-- Map -->
    <main class="map-container" aria-label="Car park map">
        <div id="map" aria-label="Interactive map of car parks"></div>
    </main>

    <!-- Detail panel -->
    @if (_selected is not null)
    {
        <div class="detail-panel" role="complementary" aria-label="Car park details">
            <button class="detail-close" @onclick="CloseDetail" aria-label="Close details">✕</button>
            <h2>@_selected.Id</h2>
            <p class="detail-address">@_selected.Address</p>
            <dl class="detail-list">
                <dt>Type</dt>
                <dd>@_selected.CarparkType</dd>
                <dt>Parking system</dt>
                <dd>@_selected.TypeOfParkingSystem</dd>
                <dt>Short-term parking</dt>
                <dd>@_selected.ShortTermParking</dd>
                <dt>Free parking</dt>
                <dd>@_selected.FreeParking</dd>
                <dt>Night parking</dt>
                <dd>@_selected.NightParking</dd>
                @if (_selected.CarparkDecks > 0)
                {
                    <dt>Decks</dt>
                    <dd>@_selected.CarparkDecks</dd>
                }
                @if (_selected.GantryHeight > 0)
                {
                    <dt>Gantry height</dt>
                    <dd>@_selected.GantryHeight m</dd>
                }
                <dt>Basement</dt>
                <dd>@(_selected.HasBasement ? "Yes" : "No")</dd>
            </dl>

            @if (_selected.Lots.Count > 0 && _selected.AvailabilityStatus != AvailabilityStatus.Unavailable)
            {
                <h3>Availability</h3>
                <table class="lot-table" aria-label="Lot availability">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Available</th>
                            <th>Total</th>
                            <th>Occupancy</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var lot in _selected.Lots)
                        {
                            int pct = lot.TotalLots > 0 ? (int)Math.Round((1.0 - (double)lot.LotsAvailable / lot.TotalLots) * 100) : 0;
                            <tr>
                                <td>@LotTypeName(lot.LotType)</td>
                                <td>@lot.LotsAvailable</td>
                                <td>@lot.TotalLots</td>
                                <td>
                                    <div class="occupancy-bar" role="progressbar"
                                         aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                                         aria-label="@pct% full">
                                        <div class="occupancy-fill @GetOccupancyClass(pct)"
                                             style="width:@pct%"></div>
                                    </div>
                                    <span class="sr-only">@pct% full</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_selected.AvailabilityStatus == AvailabilityStatus.Stale)
                {
                    <p class="freshness-note stale">⚠ Data may be stale.</p>
                }
                else
                {
                    <p class="freshness-note fresh">✓ Data is fresh.</p>
                }
            }
            else
            {
                <p class="avail-unavail">Live availability not available for this car park.</p>
            }
        </div>
    }
</div>

@code {
    private IJSObjectReference? _mapModule;
    private DotNetObjectReference<Home>? _dotNetRef;

    private string _searchQuery = string.Empty;
    private List<NominatimResult> _suggestions = [];
    private NominatimResult? _searchLocation;
    private CancellationTokenSource? _suggestCts;

    private bool _filterShortTerm;
    private bool _filterFreeParking;
    private bool _filterNightParking;
    private int _radiusMetres = 500;

    private bool _loading;
    private string? _error;
    private List<CarparkResult>? _results;
    private CarparkResult? _selected;
    private DataStatusResponse? _dataStatus;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            _mapModule = await JS.InvokeAsync<IJSObjectReference>(
                "import", "/js/map.js");
            await _mapModule.InvokeAsync<bool>("initMap", _dotNetRef, "map");
        }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? string.Empty;
        _suggestCts?.Cancel();
        _suggestCts = new CancellationTokenSource();

        if (_searchQuery.Length < 2) { _suggestions = []; return; }

        try
        {
            await Task.Delay(300, _suggestCts.Token);
            _suggestions = await Nominatim.SearchAsync(_searchQuery, _suggestCts.Token);
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
    }

    private async Task OnSearchSubmit()
    {
        if (_suggestions.Count > 0)
            await OnSuggestionSelected(_suggestions[0]);
        else if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var results = await Nominatim.SearchAsync(_searchQuery);
            if (results.Count > 0)
                await OnSuggestionSelected(results[0]);
        }
    }

    private async Task OnSuggestionSelected(NominatimResult suggestion)
    {
        _searchLocation = suggestion;
        _searchQuery = suggestion.DisplayName;
        _suggestions = [];

        if (double.TryParse(suggestion.Lat, System.Globalization.CultureInfo.InvariantCulture, out double lat) &&
            double.TryParse(suggestion.Lon, System.Globalization.CultureInfo.InvariantCulture, out double lng))
        {
            if (_mapModule is not null)
                await _mapModule.InvokeVoidAsync("setView", lat, lng, 15);

            await FetchCarparksAsync(lat, lng);
        }
    }

    private async Task OnFiltersChanged()
    {
        if (_searchLocation is null) return;
        if (double.TryParse(_searchLocation.Lat, System.Globalization.CultureInfo.InvariantCulture, out double lat) &&
            double.TryParse(_searchLocation.Lon, System.Globalization.CultureInfo.InvariantCulture, out double lng))
        {
            await FetchCarparksAsync(lat, lng);
        }
    }

    private async Task FetchCarparksAsync(double lat, double lng)
    {
        _loading = true;
        _error = null;
        _selected = null;
        StateHasChanged();

        try
        {
            _results = await ApiClient.GetNearbyAsync(
                lat, lng, _radiusMetres,
                _filterShortTerm ? true : null,
                _filterFreeParking ? true : null,
                _filterNightParking ? true : null);

            _dataStatus = await ApiClient.GetDataStatusAsync();

            if (_results is null)
            {
                _error = "Could not reach the parking data service. Please try again.";
            }
            else if (_mapModule is not null)
            {
                await _mapModule.InvokeVoidAsync("updateMarkers", _dotNetRef, _results);
                if (_results.Count > 0)
                    await _mapModule.InvokeVoidAsync("fitBounds", _results);
            }
        }
        catch (Exception)
        {
            _error = "An error occurred fetching car park data.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public async Task OnMarkerClick(string carparkId)
    {
        var cp = _results?.FirstOrDefault(r => r.Id == carparkId);
        if (cp is not null)
        {
            await OnCarparkSelected(cp);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnMapClick()
    {
        // Deselect on map background click
        _selected = null;
        StateHasChanged();
    }

    private async Task OnCarparkSelected(CarparkResult cp)
    {
        _selected = cp;
        if (_mapModule is not null)
            await _mapModule.InvokeVoidAsync("highlightMarker", cp.Latitude, cp.Longitude);
        StateHasChanged();
    }

    private void OnResultKeyDown(KeyboardEventArgs e, CarparkResult cp)
    {
        if (e.Key is "Enter" or " ")
            _ = OnCarparkSelected(cp);
    }

    private void CloseDetail()
    {
        _selected = null;
    }

    private static string FormatDistance(double metres) =>
        metres >= 1000 ? $"{metres / 1000:0.0} km" : $"{(int)metres} m";

    private static string GetAvailClass(CarparkResult cp)
    {
        if (cp.TotalCarLots == 0) return "avail-unknown";
        int pct = cp.OccupancyPercent;
        return pct < 50 ? "avail-good" : pct < 85 ? "avail-medium" : "avail-full";
    }

    private static string GetOccupancyClass(int pct) =>
        pct < 50 ? "fill-good" : pct < 85 ? "fill-medium" : "fill-full";

    private static string LotTypeName(string type) => type switch
    {
        "C" => "Car",
        "Y" => "Motorcycle",
        "H" => "Heavy vehicle",
        "S" => "Season",
        _ => type
    };

    public async ValueTask DisposeAsync()
    {
        if (_mapModule is not null)
        {
            await _mapModule.InvokeVoidAsync("destroyMap");
            await _mapModule.DisposeAsync();
        }
        _dotNetRef?.Dispose();
        _suggestCts?.Dispose();
    }
}
